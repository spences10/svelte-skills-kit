{
  "name": "svelte-skills-kit",
  "owner": {
    "name": "Scott Spence"
  },
  "metadata": {
    "description": "Svelte 5 and SvelteKit skills and language server",
    "version": "1.5.0"
  },
  "plugins": [
    {
      "name": "svelte-skills",
      "source": "./plugins/svelte-skills",
      "description": "Svelte 5 runes, SvelteKit data flow, routing, and structure patterns",
      "version": "1.3.0",
      "author": {
        "name": "Scott Spence"
      },
      "category": "framework",
      "keywords": ["svelte", "sveltekit", "runes", "routing", "ssr"],
      "repository": "https://github.com/spences10/svelte-skills-kit",
      "license": "MIT"
    },
    {
      "name": "svelte-lsp",
      "source": "./plugins/svelte-lsp",
      "description": "Svelte language server for diagnostics after edits and code navigation in .svelte files",
      "version": "1.0.0",
      "author": {
        "name": "Scott Spence"
      },
      "category": "development",
      "keywords": ["svelte", "sveltekit", "lsp", "language-server", "diagnostics"],
      "repository": "https://github.com/spences10/svelte-skills-kit",
      "license": "MIT"
    },
    {
      "name": "typescript-lsp",
      "source": "./plugins/typescript-lsp",
      "description": "TypeScript language server with the syntax server turned off, so the first LSP call of a session returns complete results",
      "version": "1.0.0",
      "author": {
        "name": "Scott Spence"
      },
      "category": "development",
      "keywords": ["typescript", "javascript", "lsp", "language-server", "diagnostics"],
      "repository": "https://github.com/spences10/svelte-skills-kit",
      "license": "MIT"
    }
  ]
}
